# Office Jukebox - Variables de Entorno
# ======================================

# Configuración del servidor HTTP
PORT=8080

# URL base del servidor para streaming
SERVER_URL=http://192.168.1.67:8080

# Directorio base para archivos multimedia
BASE_DIR=.

# Configuración de persistencia
STATE_LOG=state.log
STATE_JSON=state.json
MAX_DELTAS=1000

# Ruta a yt-dlp para extracción de YouTube
YTDLP_PATH=yt-dlp

# IP del dispositivo Sonos (dejar vacío para modo mock)
SONOS_IP=192.168.1.64

# Secreto para webhook de calendario (opcional)
CALENDAR_WEBHOOK_SECRET=jukebox-secret-key-2024

# Configuración de zonas múltiples (opcional, formato: id:ip)
# ZONE_1=default:192.168.1.100
# ZONE_2=kitchen:192.168.1.101
